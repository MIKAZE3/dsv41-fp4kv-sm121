+# ---- DSV41_CAKE_ROUTE: FlashInfer >=0.7.1 V4.1 mixed-cache decode ----
+def _flash_mla_flashinfer_dsv41(
+    q,
+    k_cache,
+    indices,
+    topk_length,
+    attn_sink,
+    head_dim_v,
+    softmax_scale,
+    extra_k_cache,
+    extra_indices,
+    extra_topk_length,
+):
+    """FlashInfer SM120/SM121 DSV4.1 mixed-cache sparse MLA decode.
+
+    Uses the ``cake_dsv4`` kernel shipped since FlashInfer 0.7.1 (PR #5983):
+    a 528 B FP8 SWA main cache plus an optional 288 B FP4 compressed extra
+    cache. Selected through ``SparseMLASm120Wrapper`` with
+    ``kv_cache_format="fp8"``, ``kv_scale_format="ue8m0_g32"`` and
+    ``extra_kv_fp4=True``.
+
+    Verified on GB10 (sm121a) against our Triton reference: out cosine
+    similarity 0.999696; LSE differs only by a constant offset.
+    """
+    from flashinfer.mla._sparse_mla_sm120 import _api as _fi_api
+
+    q2 = q.squeeze(1) if q.ndim == 4 else q
+    num_tokens, num_heads, _ = q2.shape
+    dev = q2.device
+
+    main_bpt = k_cache.shape[-1]
+    extra_bpt = extra_k_cache.shape[-1] if extra_k_cache is not None else 0
+
+    # The wrapper caches per (heads, format) pair; build lazily and reuse.
+    global _DSV41_WRAPPER_CACHE
+    try:
+        _DSV41_WRAPPER_CACHE
+    except NameError:
+        _DSV41_WRAPPER_CACHE = {}
+
+    # DSV41_CACHE_KEY_FIX: the wrapper bakes in max_num_tokens at build time,
+    # so a cache keyed only on (heads, bpt) would hand back a wrapper that is
+    # too small for a longer batch. Key on the rounded token count too, and
+    # grow the ceiling in powers of two so a warm cache serves any batch.
+    _mt = 64
+    while _mt < num_tokens:
+        _mt *= 2
+    ckey = (num_heads, main_bpt, extra_bpt, _mt)
+    wrapper = _DSV41_WRAPPER_CACHE.get(ckey)
+    if wrapper is None:
+        wrapper = _fi_api.SparseMLASm120Wrapper(
+            max_num_tokens=_mt,
+            max_num_heads=num_heads,
+            kv_cache_format="fp8",
+            kv_scale_format="ue8m0_g32",
+            extra_kv_fp4=bool(extra_bpt),
+            device=dev,
+        )
+        _DSV41_WRAPPER_CACHE[ckey] = wrapper
+
+    # FlashInfer wants the flat uint8 cache exactly as stored.
+    kv_u8 = k_cache.view(torch.uint8) if k_cache.dtype != torch.uint8 else k_cache
+    if kv_u8.ndim == 4:
+        # (pages, page_size, 1, bpt) -> (pages, page_bytes)
+        kv_u8 = kv_u8.reshape(kv_u8.shape[0], -1)
+    ex_u8 = None
+    if extra_k_cache is not None:
+        ex_u8 = (extra_k_cache.view(torch.uint8)
+                 if extra_k_cache.dtype != torch.uint8 else extra_k_cache)
+        if ex_u8.ndim == 4:
+            ex_u8 = ex_u8.reshape(ex_u8.shape[0], -1)
+
+    idx = indices.squeeze(1) if indices.dim() == 3 else indices
+    ex_idx = None
+    if extra_indices is not None:
+        ex_idx = (extra_indices.squeeze(1)
+                  if extra_indices.dim() == 3 else extra_indices)
+
+    out = torch.empty(num_tokens, num_heads, head_dim_v,
+                      dtype=torch.bfloat16, device=dev)
+    out_lse = torch.empty(num_tokens, num_heads,
+                          dtype=torch.float32, device=dev)
+
+    wrapper.run(
+        q2, kv_u8, idx, out, softmax_scale,
+        topk_length=topk_length,
+        attn_sink=attn_sink,
+        extra_kv_cache=ex_u8,
+        extra_indices=ex_idx,
+        extra_topk_length=extra_topk_length,
+        out_lse=out_lse,
+    )
+
+    if q.ndim == 4:
+        out = out.unsqueeze(1)
+        out_lse = out_lse.unsqueeze(1)
+    return out, out_lse
