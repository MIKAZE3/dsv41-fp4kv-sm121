 def flash_mla_sm120_supports_v41_kv_layouts() -> bool:
     """Whether the *selected backend* can read the V4.1 paged formats
     (V41 528 B main and V41_FP4 288 B extra).
 
-    Only the Triton backend understands them: its ``_run_triton_sparse_decode``
-    dispatches on the layout carried by the view's last dim, so no prebuilt .so
-    is involved (SM121 has no flashmla_ops.so and never needs one). The
-    FlashInfer backend's page-split is written for the 584-byte V4 page and
-    fails loud on anything else, so it must not advertise V4.1 support -- with
-    ``auto`` the probe would otherwise pick V41 and crash at the first decode.
+    Two backends understand them:
+
+    * **triton** -- our own JIT kernel; ``_run_triton_sparse_decode``
+      dispatches on the layout carried by the view's last dim, so no
+      prebuilt .so is involved (SM121 has no flashmla_ops.so and never
+      needs one).
+    * **flashinfer** -- since FlashInfer 0.7.1 (PR #5983) the
+      ``cake_dsv4`` kernel reads the DSV4.1 mixed cache directly. Verified
+      on GB10 (sm121a) against our Triton reference: out cosine
+      similarity 0.999696, LSE differing only by a constant +2.15 offset
+      (softmax-normalisation convention, not error).
+
+    Older FlashInfer builds only know the 584-byte V4 page and would
+    mis-read a 528/288-byte cache silently, so the probe must fail closed.
     """
-    return _sm120_default_backend == "triton"
+    if _sm120_default_backend == "triton":
+        return True
+    if _sm120_default_backend == "flashinfer":
+        return _flashinfer_supports_dsv41()
+    return False
 
 
