+def _flashinfer_supports_dsv41() -> bool:
+    """DSV41_GATE_EXT: whether the installed FlashInfer reads the DSV4.1 cache.
+
+    FlashInfer >= 0.7.1 (PR #5983, merged 2026-10-03) ships the ``cake_dsv4``
+    SM120/SM121 kernel for the 528 B FP8 main + 288 B FP4 compressed extra
+    cache, selected via ``SparseMLASm120Wrapper(kv_cache_format="fp8",
+    kv_scale_format="ue8m0_g32", extra_kv_fp4=True)``.
+
+    Probe defensively: any missing symbol or an older install returns False.
+    """
+    try:
+        from flashinfer.mla import cake_dsv4 as _cake
+        from flashinfer.mla._sparse_mla_sm120 import _api as _sma
+
+        if not hasattr(_cake, "run_cake_dsv4"):
+            return False
+        for sym in ("_MODEL_TYPE_DSV4_1", "_DECODE_DSV4_1_DISPATCH"):
+            if not hasattr(_sma, sym):
+                return False
+        import inspect
+
+        sig = inspect.signature(_sma.SparseMLASm120Wrapper.__init__)
+        for p in ("kv_cache_format", "kv_scale_format", "extra_kv_fp4"):
+            if p not in sig.parameters:
+                return False
+        return True
+    except Exception:
+        return False
+
