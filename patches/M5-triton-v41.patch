+@triton.jit
+def _ue8m0_to_f32(scale_u8):
+    """The ue8m0 byte as fp32: ``2 ** (byte - 127)``, byte 0 the denormal and
+    255 NaN -- identical to ``dequant_k_cache._ue8m0_to_fp32``."""
+    normal = (scale_u8.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+    denormal = tl.full(scale_u8.shape, 0x00400000, tl.int32).to(
+        tl.float32, bitcast=True
+    )
+    scale = tl.where(scale_u8 == 0, denormal, normal)
+    return tl.where(scale_u8 == 255, float("nan"), scale)
+
+
+@triton.jit
+def _e2m1_code_to_f32(code):
+    """The 4-bit e2m1 code as fp32, identical to
+    ``dequant_k_cache._e2m1_code_to_fp32``: bit 3 sign, bits 0-2 index into
+    ``[0, 0.5, 1, 1.5, 2, 3, 4, 6]``. The sign is OR-ed into the float32 sign
+    bit so a negated zero stays -0.0 (code 0x8)."""
+    m = code & 7
+    e = m >> 1
+    f = (m & 1).to(tl.float32)
+    mag = tl.where(e == 0, 0.5 * f, tl.exp2((e - 1).to(tl.float32)) * (1.0 + 0.5 * f))
+    sign = (code & 8).to(tl.int32) << 28
+    return (mag.to(tl.int32, bitcast=True) | sign).to(tl.float32, bitcast=True)
 
 
