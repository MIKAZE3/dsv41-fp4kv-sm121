+def flash_mla_sm120_supports_v41_kv_layouts() -> bool:
+    """Whether the *selected backend* can read the V4.1 paged formats
+    (V41 528 B main and V41_FP4 288 B extra).
+
+    Only the Triton backend understands them: its ``_run_triton_sparse_decode``
+    dispatches on the layout carried by the view's last dim, so no prebuilt .so
+    is involved (SM121 has no flashmla_ops.so and never needs one). The
+    FlashInfer backend's page-split is written for the 584-byte V4 page and
+    fails loud on anything else, so it must not advertise V4.1 support -- with
+    ``auto`` the probe would otherwise pick V41 and crash at the first decode.
+    """
+    return _sm120_default_backend == "triton"
+
