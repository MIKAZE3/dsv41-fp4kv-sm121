+def _e2m1_code_to_f32(code: torch.Tensor) -> torch.Tensor:
+    """e2m1 code (0..15) -> float32, bit-identical to the upstream Triton kernel.
+
+    dequant_k_cache.py:361-373: ``m = code & 7; e = m >> 1; f = m & 1`` and
+    ``mag = (e == 0) ? 0.5*f : 2^(e-1) * (1 + 0.5*f)``, then the sign is OR-ed
+    in as an integer bitcast, which preserves -0.0 (code 0x8).
+    """
+    m = code & 7
+    e = m >> 1
+    f = (m & 1).to(torch.float32)
+    mag = torch.where(
+        e == 0, 0.5 * f, torch.exp2((e - 1).to(torch.float32)) * (1.0 + 0.5 * f)
+    )
+    mag_bits = mag.view(torch.int32)
+    sign = (code & 8).to(torch.int32) << 28
+    return (mag_bits | sign).view(torch.float32)
+
+
+def _ue8m0_scale_to_f32(u8: torch.Tensor) -> torch.Tensor:
+    """ue8m0 scale byte -> float32, bit-identical to dequant_k_cache.py:349-358.
+
+    ``_ue8m0_to_fp32`` builds the value from the exponent bits, so every byte
+    decodes to exactly ``2 ** (byte - 127)`` and byte 0 is the denormal
+    ``2 ** -127`` (0x00400000), byte 255 NaN. The upstream *docstring* says
+    byte 0 is 2**-126, but its *code* emits 0x00400000 and the code is what
+    runs -- an earlier revision of this helper followed the docstring and was
+    off by 2x on every scale-byte-0 tile. The M5 addressing test compares
+    against the upstream Triton kernel and catches exactly that.
+    """
+    u = u8.to(torch.int32)
+    normal = torch.exp2((u - 127).to(torch.float32))
+    out = torch.where(u == 0, torch.full_like(normal, 2.0**-127), normal)
+    return torch.where(u == 255, torch.full_like(out, float("nan")), out)
+
