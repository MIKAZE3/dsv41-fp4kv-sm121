+def _kv_layout_of(k_cache) -> KVLayout:
+    """Layout of a (pages, page_size, 1, bytes) cache view, from its last dim."""
+    bpt = k_cache.shape[-1]
+    layout = _LAYOUT_BY_BYTES.get(bpt)
+    if layout is None:
+        raise ValueError(
+            f"unsupported DSV4 KV cache bytes-per-token {bpt}; expected one of "
+            f"{sorted(_LAYOUT_BY_BYTES)}"
+        )
+    return layout
+
