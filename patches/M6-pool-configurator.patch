+def _dsv4_kv_layout_for_sizing():
+    """The (main layout, compressed-option) the DSV4 pools will be built with.
+
+    Reads the same two environment variables as
+    ``deepseek_v4_memory_pool.select_dsv4_kv_layout`` but never touches the GPU:
+    the configurator runs during profiling, before a device context is
+    guaranteed, and it only needs the layout to price bytes. Any SM100 / SM103
+    / SM121 gate is applied by the pool itself; here the layout simply follows
+    the request, and ``v4`` (the default) keeps today's pricing.
+    """
+    mode = envs.SGLANG_DSV4_KV_LAYOUT.get().lower()
+    option = envs.SGLANG_DSV4_COMPRESSED_KV_LAYOUT.get().lower()
+    if mode == "v4":
+        return KVLayout.V4, None if option == "auto" else option
+    if mode == "v41":
+        return KVLayout.V41, option
+    # "auto" leaves the arch choice to the pool's probe; sizing stays on the
+    # conservative V4 constant rather than guessing an SM100-only layout.
+    return KVLayout.V4, None
+
+
