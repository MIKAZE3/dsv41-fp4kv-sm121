+    def _extra_kv_bytes(self) -> Optional[int]:
+        """Bytes per compressed (extra) latent token, or None for V4.
+
+        Only the (V41 main, V41_FP4 extra) pair changes the extra price: 288
+        instead of 584. A V41 main with fp8 extras stays at 528.
+
+        ``None`` means "the V4 constant applies" and is only correct when the
+        main cache is V4. Returning it for a V41 main with fp8 extras would
+        trip the fail-closed fallback below and re-price BOTH pools at 584,
+        which is exactly the over-booking this split exists to remove.
